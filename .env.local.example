# Reference-only local development environment.
# NOT used by Docker Compose builds/services. Compose uses .env by default
# (or MATCHA_ENV_FILE if you explicitly point it elsewhere).
# Copy/adapt values into .env for local-only Docker development.

API_PORT=8000
FRONTEND_PORT=5173
# Localhost-only binds (not reachable from other LAN devices).
API_BIND_HOST=127.0.0.1
FRONTEND_BIND_HOST=127.0.0.1
MAILPIT_BIND_HOST=127.0.0.1

POSTGRES_DB=matcha
POSTGRES_USER=matcha
POSTGRES_PASSWORD=replace-with-a-random-secret
DATABASE_URL=
MATCHA_SECRET=replace-with-a-random-secret

# Browser-facing origin for local-only use.
FRONTEND_URL=http://localhost:5173
# Extra browser origins allowed by the API (comma-separated).
ALLOWED_ORIGINS=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback

# Plain HTTP localhost is a secure-enough dev context for browser cookies here.
COOKIE_SECURE=false

SMTP_HOST=mail
SMTP_PORT=1025
SMTP_MODE=plain
SMTP_FROM=matcha@example.test
SMTP_USER=
SMTP_PASSWORD=

GEOCODER_URL=
GEOCODER_USER_AGENT=Matcha/1.0

SEED_PASSWORD=replace-with-a-seed-password

# Optional WebRTC relay. Empty ICE URLs support local-network calls only.
CALL_STUN_URLS=
CALL_TURN_URLS=
CALL_TURN_SECRET=
CALL_RELAY_ONLY=false
# Used only by the separately launched compose.turn.yaml relay.
TURN_PUBLIC_IP=

# Optional: GIPHY GIF search for chat (keep empty to disable the picker).
GIPHY_API_KEY=

# Local HTTPS is not needed for localhost, but Vite supports it if desired.
# TLS_CERT_FILE=/app/infra/certs/dev.crt
# TLS_KEY_FILE=/app/infra/certs/dev.key
