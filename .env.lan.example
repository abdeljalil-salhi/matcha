API_PORT=8000
FRONTEND_PORT=5173
# LAN/Wi-Fi access: expose Docker services to other devices on your network.
API_BIND_HOST=0.0.0.0
FRONTEND_BIND_HOST=0.0.0.0
MAILPIT_BIND_HOST=0.0.0.0

POSTGRES_DB=matcha
POSTGRES_USER=matcha
POSTGRES_PASSWORD=
DATABASE_URL=
MATCHA_SECRET=
# Browser-facing origin. Use a hostname Google accepts for OAuth (not a private IP).
# sslip.io/nip.io resolve a subdomain to the embedded IP, e.g. 192.168.1.55.sslip.io.
FRONTEND_URL=https://192.168.1.55.sslip.io:5173
# Comma-separated extra browser origins allowed by the API.
ALLOWED_ORIGINS=https://192.168.1.55.sslip.io:5173,https://192.168.1.55:5173,http://localhost:5173
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://192.168.1.55.sslip.io:5173/api/auth/google/callback
# Use true behind HTTPS. Camera/mic on other LAN devices require HTTPS.
COOKIE_SECURE=true

# Vite HTTPS cert/key (mounted read-only in Docker). See infra/certs/README.md.
TLS_CERTS_DIR=./infra/certs
TLS_CERT_FILE=/app/infra/certs/dev.crt
TLS_KEY_FILE=/app/infra/certs/dev.key

SMTP_HOST=mail
SMTP_PORT=1025
SMTP_MODE=plain
SMTP_FROM=matcha@example.test
SMTP_USER=
SMTP_PASSWORD=
GEOCODER_URL=
GEOCODER_USER_AGENT=Matcha/1.0
SEED_PASSWORD=
# Optional WebRTC relay. Empty ICE URLs support local-network calls only.
CALL_STUN_URLS=
CALL_TURN_URLS=
CALL_TURN_SECRET=
CALL_RELAY_ONLY=false
# Used only by the separately launched compose.turn.yaml relay.
TURN_PUBLIC_IP=

# Optional: GIPHY GIF search for chat (keep empty to disable the picker).
GIPHY_API_KEY=
