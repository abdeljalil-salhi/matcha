API_PORT=8000
FRONTEND_PORT=5173
# Localhost-only access
API_BIND_HOST=127.0.0.1
FRONTEND_BIND_HOST=127.0.0.1
MAILPIT_BIND_HOST=127.0.0.1

POSTGRES_DB=matcha
POSTGRES_USER=matcha
POSTGRES_PASSWORD=
DATABASE_URL=
MATCHA_SECRET=
# Browser-facing origin for local-only use
FRONTEND_URL=http://localhost:5173
# Comma-separated extra browser origins allowed by the API.
ALLOWED_ORIGINS=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback
# Use false for plain HTTP local dev. Set true behind HTTPS.
COOKIE_SECURE=false

# Optional Vite HTTPS (needed for camera/mic on non-localhost devices).
# Put cert/key under infra/certs/ (mounted read-only in Docker).
TLS_CERTS_DIR=./infra/certs
TLS_CERT_FILE=
TLS_KEY_FILE=

SMTP_HOST=mail
SMTP_PORT=1025
SMTP_MODE=plain
SMTP_FROM=matcha@example.test
SMTP_USER=
SMTP_PASSWORD=
GEOCODER_URL=
GEOCODER_USER_AGENT=Matcha/1.0
SEED_PASSWORD=
# Optional WebRTC relay. Empty ICE URLs support local-network calls only.
CALL_STUN_URLS=
CALL_TURN_URLS=
CALL_TURN_SECRET=
CALL_RELAY_ONLY=false
# Used only by the separately launched compose.turn.yaml relay.
TURN_PUBLIC_IP=

# Optional: GIPHY GIF search for chat (keep empty to disable the picker).
GIPHY_API_KEY=
